{
  "name": "dsh-theme-holo",
  "version": "1.0.6",
  "type": "module",
  "description": "《狼与香辛料》赫萝主题：浅色「麦秋晨光」与深色「星夜麦田」两套暖色皮肤，附带开场动画、动态档案卡、日志标签分类、右栏待机动画与可拖动探头。",
  "icon": "assets/icon-market.jpg",
  "license": "MIT",
  "author": "1015677515 (https://github.com/1015677515)",
  "contributors": [
    "holoiallo (https://github.com/holoiallo)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1015677515/dsh-theme-holo.git"
  },
  "homepage": "https://github.com/1015677515/dsh-theme-holo#readme",
  "bugs": {
    "url": "https://github.com/1015677515/dsh-theme-holo/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "theme",
    "spice-and-wolf",
    "holo"
  ],
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "assets",
    "docs",
    "素材",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0",
      "dshReleases": {
        "0.2.0-rc.1": "compatible",
        "0.2.0-rc.2": "compatible",
        "0.2.1-alpha.5": "compatible",
        "0.2.1-rc.1": "compatible",
        "0.2.1-rc.2": "compatible"
      }
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  }
}
